{
  // Relative path required here: Playwright's tsconfig loader doesn't resolve
  // package-specifier "extends" (no exports-map/hoisted node_modules lookup).
  // https://playwright.dev/docs/test-typescript#tsconfigjson
  "extends": "../tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "panda.config.ts",
    "playwright.config.ts"
  ]
}
