{
  "name": "@archon-research/uikit-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build-preview.sh",
    "clean": "rm -rf dist",
    "lint": "oxlint -c oxlint.config.ts src",
    "lint:fix": "oxlint -c oxlint.config.ts --fix src",
    "format": "oxfmt -c oxfmt.config.ts --write src",
    "format:check": "oxfmt -c oxfmt.config.ts --check src",
    "type:check": "npm run generate && tsc -p tsconfig.json --noEmit",
    "generate": "panda codegen --clean --config panda.config.ts && panda cssgen --config panda.config.ts --outfile styled-system/styles.css && panda spec --config panda.config.ts --outdir ./static/tokens/spec",
    "dev": "npm run generate && ladle serve",
    "snapshot:serve": "ladle preview --outDir dist --host 127.0.0.1 --port 61000",
    "snapshot:test": "playwright test",
    "snapshot:update": "node scripts/affected-stories.mjs",
    "snapshot:update:all": "playwright test --update-snapshots",
    "snapshot:check-orphans": "node scripts/check-orphan-snapshots.mjs",
    "cf:test": "vitest run --config demo-relay/vitest.config.ts"
  },
  "dependencies": {
    "@archon-research/charting": "*",
    "@archon-research/dashboard-kit": "*",
    "@archon-research/design-system": "*",
    "@archon-research/mcp-connect": "*",
    "@archon-research/webmcp": "*",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@archon-research/mcp-relay": "*",
    "@archon-research/oxfmt-config": "*",
    "@archon-research/oxlint-config": "*",
    "@archon-research/tsconfig": "*",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@ladle/react": "^5.1.1",
    "@pandacss/dev": "^1.10.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.7.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  }
}
