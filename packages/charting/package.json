{
  "name": "@archon-research/charting",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c oxlint.config.ts src",
    "lint:fix": "oxlint -c oxlint.config.ts --fix src",
    "format": "oxfmt -c oxfmt.config.ts --write src",
    "format:check": "oxfmt -c oxfmt.config.ts --check src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@archon-research/design-system": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@archon-research/design-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@archon-research/oxfmt-config": "*",
    "@archon-research/oxlint-config": "*",
    "@archon-research/tsconfig": "*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@visx/annotation": "^4.0.0",
    "@visx/axis": "^4.0.0",
    "@visx/brush": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/xychart": "4.0.0",
    "@visx/zoom": "^4.0.0"
  }
}
