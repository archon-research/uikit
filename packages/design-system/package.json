{
  "name": "@archon-research/design-system",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/theme-bootstrap.js"
  ],
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./panda-preset": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "default": "./dist/components/data-table/index.js"
    },
    "./drawer": {
      "types": "./dist/components/Drawer.d.ts",
      "default": "./dist/components/Drawer.js"
    },
    "./theme-bootstrap.js": "./dist/theme-bootstrap.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-theme-bootstrap.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c oxlint.config.ts --max-warnings=0 src",
    "lint:fix": "oxlint -c oxlint.config.ts --fix src",
    "format": "oxfmt -c oxfmt.config.ts --write src",
    "format:check": "oxfmt -c oxfmt.config.ts --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.0",
    "@pandacss/dev": "1.12.0",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "1.33.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@archon-research/oxfmt-config": "*",
    "@archon-research/oxlint-config": "*",
    "@archon-research/tsconfig": "*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "^30.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.9"
  }
}
