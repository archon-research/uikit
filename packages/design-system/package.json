{
  "name": "@archon-research/design-system",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./panda-preset": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "default": "./dist/components/data-table/index.js"
    },
    "./drawer": {
      "types": "./dist/components/Drawer.d.ts",
      "default": "./dist/components/Drawer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c oxlint.config.ts src",
    "lint:fix": "oxlint -c oxlint.config.ts --fix src",
    "format": "oxfmt -c oxfmt.config.ts --write src",
    "format:check": "oxfmt -c oxfmt.config.ts --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ark-ui/react": "5.37.2",
    "@pandacss/dev": "1.11.4",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "1.25.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@archon-research/oxlint-config": "*",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  }
}
