{
  // `.github/scripts` is not an npm workspace, so it has no package of its own
  // to hang a `type:check` script off. The root `type:check` runs tsc against
  // this project directly -- see the root package.json.
  "extends": "@archon-research/tsconfig/node",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
